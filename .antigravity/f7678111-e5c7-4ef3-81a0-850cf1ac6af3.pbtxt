    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { MatchResult } from \'../types\';\nimport { Calendar, DollarSign, Building, ExternalLink, ChevronDown, ChevronUp, Check, Info, AlertCircle } from \'lucide-react\';\n\ninterface ScholarshipCardProps {\n  key?: string;\n  result: MatchResult;\n}\n\nexport default function ScholarshipCard({ result }: ScholarshipCardProps) {\n  const [expanded, setExpanded] = useState(false);\n  const { scholarship, score, matchFactors, category } = result;\n\n  // Visual configuration based on category\n  const getCategoryStyles = (cat: typeof category) => {\n    switch (cat) {\n      case \'Strong Match\':\n        return {\n          bg: \'bg-purple-50 border-purple-300\',\n          badge: \'bg-[#4F2D7F] text-white border border-[#E8C84A]\',\n          scoreText: \'text-[#4F2D7F] font-black\',\n          glow: \'shadow-md shadow-purple-100 ring-2 ring-purple-100/50\',\n          progressColor: \'bg-[#4F2D7F]\',\n        };\n      case \'Possible Match\':\n        return {\n          bg: \'bg-indigo-50/40 border-indigo-200\',\n          badge: \'bg-indigo-100 text-indigo-900 border border-indigo-200\',\n          scoreText: \'text-indigo-900 font-bold\',\n          glow: \'shadow-sm\',\n          progressColor: \'bg-indigo-600\',\n        };\n      case \'Worth Exploring\':\n        return {\n          bg: \'bg-slate-50/50 border-slate-200\',\n          badge: \'bg-slate-100 text-slate-700 border border-slate-250\',\n          scoreText: \'text-slate-700 font-bold\',\n          glow: \'shadow-sm\',\n          progressColor: \'bg-slate-500\',\n        };\n    }\n  };\n\n  const styles = getCategoryStyles(category);\n\n  return (\n    <div \n      id={`scholarship-card-${scholarship.id}`}\n      className={`bg-white rounded-2xl border transition-all duration-300 overflow-hidden ${styles.glow} hover:shadow-lg`}\n    >\n      {/* CARD TOP MAIN BLOCK */}\n      <div className=\"p-5 md:p-6 space-y-4\">\n        {/* Row 1: Category & Score */}\n        <div className=\"flex flex-wrap items-center justify-between gap-2.5\">\n          <div className=\"flex items-center gap-2\">\n            <span className={`text-xs px-3 py-1 rounded-full font-bold uppercase tracking-wider ${styles.badge}`}>\n              {category}\n            </span>\n            <span className=\"text-xs text-gray-400 font-mono\">\n              ID: {scholarship.id}\n            </span>\n          </div>\n          \n          <div className=\"flex items-center gap-1.5 bg-gray-100/80 px-3 py-1 rounded-full\">\n            <span className=\"text-xs font-semibold text-gray-500 uppercase\">Match Score:</span>\n            <span className={`text-sm ${styles.scoreText}`}>{score}/100</span>\n          </div>\n        </div>\n\n        {/* Row 2: Scholarship Name & Organization */}\n        <div>\n          <h3 className=\"text-lg md:text-xl font-bold text-gray-900 tracking-tight leading-snug\">\n            {scholarship.name}\n          </h3>\n          <div className=\"flex items-center gap-1.5 text-gray-500 text-sm mt-1\">\n            <Building className=\"w-4 h-4 text-gray-400 shrink-0\" />\n            <span className=\"font-medium\">{scholarship.organization}</span>\n          </div>\n        </div>\n\n        {/* Row 3: Key Details (Amount & Deadline) */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5 bg-gray-50 p-3.5 rounded-xl border border-gray-100\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"bg-[#E8C84A]/20 text-[#4F2D7F] p-2 rounded-lg shrink-0\">\n              <DollarSign className=\"w-4.5 h-4.5 font-bold\" />\n            </div>\n            <div>\n              <p className=\"text-[10px] text-gray-400 uppercase tracking-wider font-bold\">Award Value</p>\n              <p className=\"text-base font-extrabold text-[#4F2D7F]\">{scholarship.amount}</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"bg-purple-100 text-purple-700 p-2 rounded-lg shrink-0\">\n              <Calendar className=\"w-4.5 h-4.5\" />\n            </div>\n            <div>\n              <p className=\"text-[10px] text-gray-400 uppercase tracking-wider font-bold\">Application Deadline</p>\n              <p className=\"text-sm font-bold text-gray-700\">{scholarship.deadline}</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Row 4: Eligibility Summary */}\n        <div className=\"space-y-1.5\">\n          <div className=\"flex items-center gap-1.5 text-xs font-bold text-gray-500 uppercase tracking-wider\">\n            <Info className=\"w-3.5 h-3.5 text-gray-400\" />\n            <span>Eligibility Summary</span>\n          </div>\n          <p className=\"text-sm text-gray-600 leading-relaxed font-medium\">\n            {scholarship.eligibilitySummary}\n          </p>\n        </div>\n      </div>\n\n      {/* DETAILED SCORE EXPLANATION BLOCK (ACCORDION) */}\n      <div className=\"border-t border-gray-100 bg-gray-50/50\">\n        <button\n          type=\"button\"\n          onClick={() => setExpanded(!expanded)}\n          className=\"w-full flex items-center justify-between py-3.5 px-5 md:px-6 text-xs font-bold text-gray-600 hover:text-[#4F2D7F] hover:bg-purple-50/10 transition-colors focus:outline-none\"\n        >\n          <span className=\"flex items-center gap-1.5\">\n            <span>Score Breakdown & Why It Matched</span>\n            <span className=\"bg-gray-200 text-gray-700 px-1.5 py-0.5 rounded font-mono text-[10px]\">\n              {matchFactors.filter(f => f.points > 0).length} Factors\n            </span>\n          </span>\n          {expanded ? <ChevronUp className=\"w-4 h-4\" /> : <ChevronDown className=\"w-4 h-4\" />}\n        </button>\n\n        {expanded && (\n          <div className=\"px-5 md:px-6 pb-5 space-y-4 pt-1 border-t border-gray-100 animate-fadeIn\">\n            {/* MATCHING FACTORS LIST */}\n            <div className=\"space-y-3\">\n              {matchFactors.map((factor, index) => {\n                const isMatched = factor.points > 0;\n                return (\n                  <div \n                    key={index} \n                    className={`flex items-start gap-3 p-3 rounded-xl border ${\n                      isMatched \n                        ? \'bg-emerald-50/40 border-emerald-100 text-emerald-950\' \n                        : \'bg-gray-50 border-gray-100 text-gray-500 opacity-65\'\n                    }`}\n                  >\n                    <div className=\"mt-0.5\">\n                      {isMatched ? (\n                        <div className=\"bg-emerald-500 text-white rounded-full p-0.5 flex items-center justify-center\">\n                          <Check className=\"w-3.5 h-3.5\" />\n                        </div>\n                      ) : (\n                        <div className=\"bg-gray-200 text-gray-400 rounded-full p-0.5 flex items-center justify-center\">\n                          <AlertCircle className=\"w-3.5 h-3.5\" />\n                        </div>\n                      )}\n                    </div>\n                    \n                    <div className=\"flex-1 space-y-0.5\">\n                      <div className=\"flex items-center justify-between gap-2\">\n                        <span className=\"text-xs font-extrabold tracking-tight uppercase\">\n                          {factor.category}\n                        </span>\n                        <span className={`text-xs font-mono font-bold ${isMatched ? \'text-emerald-700\' : \'text-gray-400\'}`}>\n                          +{factor.points} / {factor.maxPoints} pts\n                        </span>\n                      </div>\n                      <p className=\"text-sm font-medium leading-relaxed\">\n                        {factor.description}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* PROGRESS VISUALIZER */}\n            <div className=\"bg-white p-3.5 rounded-xl border border-gray-200/80 shadow-inner\">\n              <div className=\"flex items-center justify-between text-xs font-bold text-gray-500 mb-1.5 uppercase\">\n                <span>Match Score Progress</span>\n                <span>{score} / 100 Points</span>\n              </div>\n              <div className=\"w-full bg-gray-150 h-3.5 rounded-full overflow-hidden\">\n                <div \n                  className={`h-full transition-all duration-500 rounded-full ${styles.progressColor}`}\n                  style={{ width: `${score}%` }}\n                />\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* EXTERNAL LINK BUTTON CONTAINER */}\n      <div className=\"bg-gray-50 p-4 border-t border-gray-100 flex items-center justify-end\">\n        <a\n          href={scholarship.applicationUrl}\n          target=\"_blank\"\n          referrerPolicy=\"no-referrer\"\n          rel=\"noopener noreferrer\"\n          className=\"inline-flex items-center gap-1.5 bg-[#4F2D7F] hover:bg-[#3d2262] text-[#E8C84A] hover:text-white px-4 py-2.5 rounded-xl text-sm font-bold transition-all duration-150 shadow-sm hover:shadow active:scale-95\"\n        >\n          <span>Official Application</span>\n          <ExternalLink className=\"w-4 h-4\" />\n        </a>\n      </div>\n    </div>\n  );"
      replacement_content: "import React, { useState } from \'react\';\nimport { MatchResult } from \'../types\';\nimport { Calendar, DollarSign, Building, ExternalLink, ChevronDown, ChevronUp, Check, Info, AlertCircle } from \'lucide-react\';\n\ninterface ScholarshipCardProps {\n  key?: string;\n  result: MatchResult;\n}\n\nexport default function ScholarshipCard({ result }: ScholarshipCardProps) {\n  const [expanded, setExpanded] = useState(false);\n  const { scholarship, score, matchFactors, category } = result;\n\n  // Visual styling parameters based on matching classification\n  const getCategoryTheme = (cat: typeof category) => {\n    switch (cat) {\n      case \'Strong Match\':\n        return {\n          leftBorder: \'border-l-8 border-green-500\',\n          scoreTextColor: \'text-green-600\',\n          badgeClass: \'bg-green-50 text-green-700\',\n          badgeText: \'STRONG\',\n          progressColor: \'bg-green-500\',\n          rowGlow: \'hover:shadow-green-50/50\',\n        };\n      case \'Possible Match\':\n        return {\n          leftBorder: \'border-l-8 border-blue-400\',\n          scoreTextColor: \'text-blue-500\',\n          badgeClass: \'bg-blue-50 text-blue-700\',\n          badgeText: \'POSSIBLE\',\n          progressColor: \'bg-blue-500\',\n          rowGlow: \'hover:shadow-blue-50/50\',\n        };\n      case \'Worth Exploring\':\n        return {\n          leftBorder: \'border-l-8 border-slate-300\',\n          scoreTextColor: \'text-slate-500\',\n          badgeClass: \'bg-slate-100 text-slate-700\',\n          badgeText: \'EXPLORING\',\n          progressColor: \'bg-slate-400\',\n          rowGlow: \'hover:shadow-slate-100/50\',\n        };\n    }\n  };\n\n  const theme = getCategoryTheme(category);\n\n  // Get active matching factors (positive score contributions)\n  const positiveFactors = matchFactors.filter(f => f.points > 0);\n\n  return (\n    <div \n      id={`scholarship-card-${scholarship.id}`}\n      className={`bg-white rounded-3xl p-5 md:p-6 shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-all duration-200 ${theme.leftBorder} ${theme.rowGlow}`}\n    >\n      {/* LEFT BLOCK: Score Column */}\n      <div className=\"w-full md:w-28 flex flex-row md:flex-col items-center justify-between md:justify-center border-b md:border-b-0 md:border-r border-slate-100 pb-4 md:pb-0 md:pr-6 shrink-0 gap-2\">\n        <div className=\"flex md:flex-col items-center gap-1.5 md:gap-0\">\n          <span className={`text-4xl font-black ${theme.scoreTextColor} leading-none tracking-tight`}>\n            {score}\n          </span>\n          <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-widest text-center mt-0.5\">\n            Match Score\n          </span>\n        </div>\n        \n        <div className={`px-2.5 py-1 ${theme.badgeClass} text-[10px] font-black rounded-md uppercase tracking-wider text-center`}>\n          {theme.badgeText}\n        </div>\n      </div>\n\n      {/* RIGHT BLOCK: Content details */}\n      <div className=\"flex-1 space-y-4\">\n        \n        {/* Title & Organization Header */}\n        <div className=\"flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2\">\n          <div className=\"space-y-1\">\n            <h3 className=\"text-lg md:text-xl font-bold text-[#4F2D7F] tracking-tight leading-snug\">\n              {scholarship.name}\n            </h3>\n            <p className=\"text-xs md:text-sm font-semibold text-slate-500\">\n              {scholarship.organization}\n            </p>\n          </div>\n          <span className=\"text-xl md:text-2xl font-black text-slate-800 tracking-tight shrink-0\">\n            {scholarship.amount}\n          </span>\n        </div>\n\n        {/* Dynamic Overview Columns */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs pt-1 border-t border-slate-50\">\n          \n          {/* Column A: Positive matches */}\n          <div className=\"space-y-2\">\n            <p className=\"text-slate-400 uppercase font-bold text-[10px] tracking-wider\">\n              Why you matched:\n            </p>\n            {positiveFactors.length === 0 ? (\n              <p className=\"text-gray-500 italic\">Meets fundamental baseline filters.</p>\n            ) : (\n              <ul className=\"space-y-1.5\">\n                {positiveFactors.slice(0, 3).map((factor, idx) => (\n                  <li key={idx} className=\"flex items-start gap-2 text-slate-700 font-medium\">\n                    <span className=\"w-1.5 h-1.5 bg-green-500 rounded-full mt-1.5 shrink-0\" />\n                    <span>{factor.category} (+{factor.points})</span>\n                  </li>\n                ))}\n                {positiveFactors.length > 3 && (\n                  <li className=\"text-[#4F2D7F] font-bold text-[10px]\">\n                    + {positiveFactors.length - 3} more matching attributes\n                  </li>\n                )}\n              </ul>\n            )}\n          </div>\n\n          {/* Column B: Metadata Info */}\n          <div className=\"space-y-2\">\n            <p className=\"text-slate-400 uppercase font-bold text-[10px] tracking-wider\">\n              Deadline:\n            </p>\n            <p className=\"font-bold text-slate-800 text-sm\">\n              {scholarship.deadline}\n            </p>\n            \n            <p className=\"text-slate-400 uppercase font-bold text-[10px] tracking-wider pt-1 block\">\n              Academic Threshold:\n            </p>\n            <p className=\"text-xs text-slate-600 font-medium\">\n              Requires min GPA of <span className=\"font-bold text-[#4F2D7F]\">{scholarship.minGpaRange}</span>\n            </p>\n          </div>\n\n        </div>\n\n        {/* Eligibility Brief block */}\n        <div className=\"bg-slate-50/70 p-3 rounded-2xl border border-slate-100 text-xs text-slate-600 leading-relaxed font-medium\">\n          <span className=\"font-bold text-[#4F2D7F] block mb-0.5 uppercase text-[9px] tracking-wider\">Core Eligibility Scope:</span>\n          {scholarship.eligibilitySummary}\n        </div>\n\n        {/* Buttons / Collapsible trigger */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 pt-2\">\n          <button\n            type=\"button\"\n            onClick={() => setExpanded(!expanded)}\n            className=\"inline-flex items-center gap-1 text-xs font-bold text-slate-500 hover:text-[#4F2D7F] transition-colors focus:outline-none\"\n          >\n            <span>{expanded ? \'Hide full scoring matrix\' : \'Show score breakdown\'}</span>\n            {expanded ? <ChevronUp className=\"w-3.5 h-3.5\" /> : <ChevronDown className=\"w-3.5 h-3.5\" />}\n          </button>\n\n          <a\n            href={scholarship.applicationUrl}\n            target=\"_blank\"\n            referrerPolicy=\"no-referrer\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-1.5 text-[#4F2D7F] hover:text-[#3d2262] font-bold text-sm underline underline-offset-4 decoration-2 decoration-[#E8C84A] hover:decoration-[#4F2D7F] transition-all\"\n          >\n            <span>Apply Online</span>\n            <ExternalLink className=\"w-3.5 h-3.5\" />\n          </a>\n        </div>\n\n        {/* Expanded score breakdown */}\n        {expanded && (\n          <div className=\"border-t border-slate-100 pt-4 mt-2 space-y-4 animate-fadeIn\">\n            <div className=\"space-y-2\">\n              {matchFactors.map((factor, index) => {\n                const isMatched = factor.points > 0;\n                return (\n                  <div \n                    key={index} \n                    className={`flex items-start gap-2.5 p-2.5 rounded-xl border ${\n                      isMatched \n                        ? \'bg-emerald-50/40 border-emerald-100 text-emerald-950\' \n                        : \'bg-slate-50 border-slate-100 text-slate-500 opacity-70\'\n                    }`}\n                  >\n                    <div className=\"mt-0.5\">\n                      {isMatched ? (\n                        <div className=\"bg-emerald-500 text-white rounded-full p-0.5 flex items-center justify-center shrink-0\">\n                          <Check className=\"w-3 h-3\" />\n                        </div>\n                      ) : (\n                        <div className=\"bg-slate-200 text-slate-400 rounded-full p-0.5 flex items-center justify-center shrink-0\">\n                          <AlertCircle className=\"w-3 h-3\" />\n                        </div>\n                      )}\n                    </div>\n                    \n                    <div className=\"flex-1 min-w-0\">\n                      <div className=\"flex items-center justify-between gap-2\">\n                        <span className=\"text-[10px] font-extrabold tracking-tight uppercase\">\n                          {factor.category}\n                        </span>\n                        <span className={`text-xs font-mono font-bold ${isMatched ? \'text-emerald-700\' : \'text-slate-400\'}`}>\n                          +{factor.points} / {factor.maxPoints} pts\n                        </span>\n                      </div>\n                      <p className=\"text-xs leading-relaxed mt-0.5 font-medium text-slate-600\">\n                        {factor.description}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* PROGRESS VISUALIZER */}\n            <div className=\"bg-white p-3 rounded-xl border border-slate-150 shadow-inner\">\n              <div className=\"flex items-center justify-between text-[10px] font-bold text-slate-500 mb-1 uppercase tracking-wider\">\n                <span>Calculated Scoring Progress</span>\n                <span>{score} / 100 Points</span>\n              </div>\n              <div className=\"w-full bg-slate-100 h-2 rounded-full overflow-hidden\">\n                <div \n                  className={`h-full transition-all duration-500 rounded-full ${theme.progressColor}`}\n                  style={{ width: `${score}%` }}\n                />\n              </div>\n            </div>\n          </div>\n        )}\n\n      </div>\n    </div>\n  );\n}"
    }
