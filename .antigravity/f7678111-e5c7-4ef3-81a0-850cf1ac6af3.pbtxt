,\n    deadline: \"April 30, 2027\",\n    eligibilitySummary: \"For Canadians with inherited bleeding disorders or blood transfusion-related illnesses (and their immediate families) pursuing post-secondary studies.\",\n    applicationUrl: \"https://www.hemophilia.ca/james-kreppner-memorial-scholarship-and-bursary-program/\",\n    targetDegree: \'All\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Student with disability\'],\n    targetInterests: []\n  },\n  {\n    id: \'longhouse-business-award\',\n    name: \"Longhouse Business Award\",\n    organization: \"Longhouse\",\n    amount: \"$2,000 (x5 students)\",\n    deadline: \"August 31, 2026\",\n    eligibilitySummary: \"Awarded to business students in Canada, with 3 of 5 awards reserved specifically for Indigenous business students. Applications open year-round.\",\n    applicationUrl: \"https://www.longhouse.co/longhouse-business-award/\",\n    targetDegree: \'All\',\n    targetFaculties: [\'Business/Ivey\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Indigenous\'],\n    targetInterests: [\'Leadership\']\n  },\n  {\n    id: \'loran-award\',\n    name: \"Loran Award\",\n    organization: \"Loran Scholars Foundation\",\n    amount: \"Tuition waiver + living stipend (4 years)\",\n    deadline: \"October 15, 2026\",\n    eligibilitySummary: \"Highly prestigious entrance scholarship awarded based on character, leadership, and community service. For students entering their first year of undergraduate study.\",\n    applicationUrl: \"http://www.loranscholar.ca\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'lumine-future-leaders\',\n    name: \"Lumine Future Leaders in Technology & Business\",\n    organization: \"Lumine Group\",\n    amount: \"$2,000 USD (x5 winners)\",\n    deadline: \"July 10, 2026\",\n    eligibilitySummary: \"Open to Canadian students in STEM or Business who self-identify as belonging to a minority group (disabilities, visible minorities, women, LGBTQ2S+).\",\n    applicationUrl: \"https://www.luminegroup.com/resources/lumine-group-scholarship\",\n    targetDegree: \'All\',\n    targetFaculties: [\'Science\', \'Engineering\', \'Business/Ivey\'],\n    minGpaRange: \'75\342\200\22379%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Student with disability\', \'Indigenous\', \'Black student\', \'Woman\', \'LGBTQ2S+\'],\n    targetInterests: [\'STEM research\', \'Leadership\']\n  },\n  {\n    id: \'madd-canada-leadership\',\n    name: \"MADD Canada \342\200\224 Louise Joanne Twerdy Leadership Bursary\",\n    organization: \"MADD Canada\",\n    amount: \"$10,000 (top award); $5,000 (others)\",\n    deadline: \"May 31, 2026\",\n    eligibilitySummary: \"Awarded to Canadian students severely injured or who have lost immediate family members in impaired driving crashes. Based on leadership and community involvement.\",\n    applicationUrl: \"https://madd.ca/pages/programs/victimsurvivor-services/youth-bursary-fund/\",\n    targetDegree: \'All\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'Canadian citizen\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\']\n  },\n  {\n    id: \'manulife-life-lessons\',\n    name: \"Manulife Life Lessons Scholarship Program\",\n    organization: \"Manulife\",\n    amount: \"$10,000\",\n    deadline: \"March 31, 2027\",\n    eligibilitySummary: \"Supports undergraduate students in Canada (ages 17\342\200\22324) who have experienced the death of a parent or guardian who had little or no life insurance.\",\n    applicationUrl: \"https://www.manulife.ca/personal/plan-and-learn/life-events/life-lessons-scholarship.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: []\n  },\n  {\n    id: \'mccall-macbain-scholarships\',\n    name: \"McCall MacBain Scholarships\",\n    organization: \"McCall MacBain Foundation / McGill University\",\n    amount: \"Full tuition + $2,300/mo stipend\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Full funding for master\'s or second-entry professional undergraduate programs at McGill. Highly competitive. Evaluated on character, leadership, and service.\",\n    applicationUrl: \"https://mccallmacbainscholars.org/program/\",\n    targetDegree: \'Graduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'td-scholarship-cs\',\n    name: \"TD Scholarship in Computer Science\",\n    organization: \"TD Bank / Western University\",\n    amount: \"$1,600/year (up to 3 years)\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Available to Year 2+ undergraduate Computer Science students at Western who demonstrate financial need and academic standing. Renewable annually.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Science\'],\n    minGpaRange: \'75\342\200\22379%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\']\n  },\n  {\n    id: \'td-scholarship-engineering\',\n    name: \"TD Scholarship in Engineering\",\n    organization: \"TD Bank / Western University\",\n    amount: \"$1,600/year (up to 4 years)\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"For Western undergraduate engineering students entering Year 1 who intend to declare Electrical, Computer, or Software Engineering. Requires minimum 85% average.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Engineering\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\']\n  },\n  {\n    id: \'td-scholarship-fims\',\n    name: \"TD Scholarship in Information and Media Studies\",\n    organization: \"TD Bank / Western University\",\n    amount: \"$2,700/year (up to 4 years)\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"For students entering Year 1 of Media and Communication Studies at Western. Requires min 85% admission average and demonstrated financial need.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Information & Media Studies\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: []\n  },\n  {\n    id: \'betty-schecter-memorial-cs\',\n    name: \"Betty Schecter Memorial Scholarship in Computer Science\",\n    organization: \"Western University\",\n    amount: \"$5,000\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Awarded to female undergraduate students in Year 1 of a Computer Science degree at Western (Faculty of Science) who exhibit leadership, community service, and high merit.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Science\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Woman\'],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\', \'STEM research\']\n  },\n  {\n    id: \'chris-binns-smith-memorial-cs\',\n    name: \"Chris Binns-Smith Memorial Scholarship in Computer Science\",\n    organization: \"Western University\",\n    amount: \"$5,000\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Offered to Year 1 Computer Science students at Western. Evaluated on leadership, extracurriculars, volunteering, and excellent academic stand.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Science\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\', \'STEM research\']\n  },\n  {\n    id: \'john-schecter-memorial-cs\',\n    name: \"John Schecter Memorial Scholarship in Computer Science\",\n    organization: \"Western University\",\n    amount: \"$5,000\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Sponsors Year 1 Computer Science students demonstrating leadership, solid community volunteering, and exceptional academic credentials.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Science\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\', \'STEM research\']\n  },\n  {\n    id: \'spadotto-greco-women-engineering\',\n    name: \"Spadotto and Greco Family Women in Engineering Award\",\n    organization: \"Western University\",\n    amount: \"$1,000\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Awarded to female undergraduate students in Year 1 of Engineering at Western, based on strong academic achievement and community or extracurricular leadership.\",\n    applicationUrl: \"https://www.eng.uwo.ca/undergraduate\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Engineering\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Woman\'],\n    targetInterests: [\'Leadership\', \'STEM research\']\n  },\n  {\n    id: \'james-emerson-miles-engineering\',\n    name: \"James Emerson Miles Admission Scholarship\",\n    organization: \"Western University\",\n    amount: \"$8,500\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"For Year 1 Engineering students at Western. Requires Ontario residency and demonstrated financial need. Preference for children of building trade artisans.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Engineering\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\']\n  },\n  {\n    id: \'ivey-international-exchange-award\',\n    name: \"Ivey Foundation Awards for International Exchange\",\n    organization: \"Western University / Ivey Foundation\",\n    amount: \"$6,500 (up to 7 awards)\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Supports upper-year Western students accepted into an international exchange program. Requires minimum 80% average, financial need, and Ontario residency.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: []\n  },\n  {\n    id: \'deans-undergrad-social-science\',\n    name: \"Dean\'s Undergraduate Scholarship in Social Science\",\n    organization: \"Western University\",\n    amount: \"$5,000\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Supports students entering Year 1 of Faculty of Social Science. Evaluated on academic standing (80%+), financial need, and extensive high school extracurriculars.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Social Science\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'mary-louise-peter-cameron-scholarship\',\n    name: \"Mary Louise and Dr. Peter Cameron Scholarships\",\n    organization: \"Western University / Memorial Funeral Home\",\n    amount: \"$5,000/year (continuing)\",\n    deadline: \"No application required\",\n    eligibilitySummary: \"Awarded automatically by the Registrar to Year 1 students entering with a mobility, visual, or hearing impairment. Minimum 80% admission average.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Student with disability\'],\n    targetInterests: []\n  },\n  {\n    id: \'western-excellence-black-students\',\n    name: \"Western Continuing Admission Scholarship of Excellence for Black Students\",\n    organization: \"Western University\",\n    amount: \"$6,000/year (up to 4 years) + $2,000 study abroad\",\n    deadline: \"No application required\",\n    eligibilitySummary: \"Awarded at admission stage to high-achieving Black students entering from high school. Based on competitive admission average (85%+).\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Black student\'],\n    targetInterests: []\n  },\n  {\n    id: \'western-excellence-indigenous-students\',\n    name: \"Western Continuing Admission Scholarship of Excellence for Indigenous Students\",\n    organization: \"