    replacement_chunks {
      replacement_content: "import { Scholarship } from \'../types\';\n\nexport const SCHOLARSHIPS: Scholarship[] = [\n  {\n    id: \'w-presidents-entrance\',\n    name: \"President\'s Entrance Scholarship\",\n    organization: \"Western University\",\n    amount: \"$50,000\",\n    deadline: \"October 31, 2026\",\n    eligibilitySummary: \"Outstanding academic achievement (90%+ GPA), strong leadership qualities, and registered as a first-year undergraduate student.\",\n    applicationUrl: \"https://registrar.uwo.ca/student_finances/scholarships_awards/presidents_entrance_scholarships.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'90%+\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'w-alumni-leadership\',\n    name: \"Western Alumni Association Leadership Award\",\n    organization: \"Western Alumni Foundation\",\n    amount: \"$5,000\",\n    deadline: \"November 15, 2026\",\n    eligibilitySummary: \"Awarded to full-time undergraduate students who demonstrate high academic standing (80%+ GPA) and exceptional volunteering and leadership contributions.\",\n    applicationUrl: \"https://alumni.westernu.ca/benefits/scholarships.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'w-ivey-hba-entrepreneur\',\n    name: \"Ivey HBA Entrepreneurial Scholarship\",\n    organization: \"Ivey Business School\",\n    amount: \"$10,000\",\n    deadline: \"January 20, 2027\",\n    eligibilitySummary: \"Available to HBA students who demonstrate an interest in entrepreneurship, start-up ventures, and strong academic standing (85%+ GPA).\",\n    applicationUrl: \"https://www.ivey.uwo.ca/hba/scholarships-financial-aid/\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Business/Ivey\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Entrepreneurship\', \'Leadership\']\n  },\n  {\n    id: \'on-grad-scholarship\',\n    name: \"Ontario Graduate Scholarship (OGS)\",\n    organization: \"Province of Ontario & Western University\",\n    amount: \"$15,000\",\n    deadline: \"January 15, 2027\",\n    eligibilitySummary: \"Promotes excellence in graduate studies at the master\'s and doctoral levels. Requires 80%+ GPA, research potential, and Ontario residency.\",\n    applicationUrl: \"https://grad.uwo.ca/finances/external_funding/ogs.html\",\n    targetDegree: \'Graduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\', \'Protected/refugee status\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\']\n  },\n  {\n    id: \'w-eng-women-tech\',\n    name: \"Engineering Women in Technology Award\",\n    organization: \"Western Engineering\",\n    amount: \"$7,500\",\n    deadline: \"March 1, 2027\",\n    eligibilitySummary: \"Awarded to female undergraduate engineering students who show academic excellence (80%+ GPA) and are actively involved in STEM or leadership initiatives.\",\n    applicationUrl: \"https://www.eng.uwo.ca/undergraduate/funding/awards.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Engineering\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Woman\'],\n    targetInterests: [\'STEM research\', \'Leadership\']\n  },\n  {\n    id: \'w-indigenous-access\',\n    name: \"Indigenous Student Access Scholarship\",\n    organization: \"Indigenous Student Centre, Western\",\n    amount: \"$6,000\",\n    deadline: \"December 1, 2026\",\n    eligibilitySummary: \"Supports Indigenous students (First Nations, M\303\251tis, Inuit) registered in any undergraduate faculty at Western. Based on financial need and community involvement.\",\n    applicationUrl: \"https://indigenous.uwo.ca/students/financial_support.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [\'Indigenous\'],\n    targetInterests: [\'Volunteering/community service\']\n  },\n  {\n    id: \'w-black-student-excellence\',\n    name: \"Western Black Student Excellence Award\",\n    organization: \"Western University Equity & Diversity Office\",\n    amount: \"$5,000\",\n    deadline: \"February 28, 2027\",\n    eligibilitySummary: \"Awarded to Black students registered in any undergraduate or graduate program who show strong academic standing and leadership within Black communities.\",\n    applicationUrl: \"https://registrar.uwo.ca/student_finances/scholarships_awards/black_student_scholarships.html\",\n    targetDegree: \'All\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'75\342\200\22379%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'Black student\'],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'w-schulich-leader\',\n    name: \"Schulich Leader Scholarship\",\n    organization: \"Schulich Foundation & Western University\",\n    amount: \"$120,000\",\n    deadline: \"January 30, 2027\",\n    eligibilitySummary: \"Highly competitive award for high-achieving undergraduate students enrolling in STEM faculties (Science, Engineering). Requires 90%+ GPA, exceptional leadership, and research drive.\",\n    applicationUrl: \"https://www.schulichleaders.com/\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Science\', \'Engineering\'],\n    minGpaRange: \'90%+\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\', \'Leadership\', \'Entrepreneurship\']\n  },\n  {\n    id: \'w-science-research\',\n    name: \"Faculty of Science Summer Research Grant\",\n    organization: \"Western Faculty of Science\",\n    amount: \"$4,500\",\n    deadline: \"February 15, 2027\",\n    eligibilitySummary: \"A fellowship designed to sponsor science undergraduate students engaged in summer laboratory research projects. Minimum GPA of 85%.\",\n    applicationUrl: \"https://www.uwo.ca/sci/research/undergraduate_research/index.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Science\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\']\n  },\n  {\n    id: \'w-arts-creative-grant\',\n    name: \"Arts & Humanities Creative & Performing Arts Grant\",\n    organization: \"Western Arts Alumni\",\n    amount: \"$3,000\",\n    deadline: \"April 1, 2027\",\n    eligibilitySummary: \"Offered to Arts & Humanities or Music students demonstrating creative merit, local art engagement, and academic consistency (75%+ GPA).\",\n    applicationUrl: \"https://www.uwo.ca/arts/undergraduate/awards.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Arts & Humanities\', \'Music\'],\n    minGpaRange: \'75\342\200\22379%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Arts/music\', \'Volunteering/community service\']\n  },\n  {\n    id: \'beryl-ivey-memorial\',\n    name: \"Beryl Ivey Memorial Scholarship\",\n    organization: \"Western University\",\n    amount: \"$8,000\",\n    deadline: \"March 30, 2027\",\n    eligibilitySummary: \"Awarded to a female undergraduate student in any faculty who is an Ontario resident, demonstrates high financial need, and shows outstanding volunteering commitments.\",\n    applicationUrl: \"https://registrar.uwo.ca/student_finances/financial_support/index.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'75\342\200\22379%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [\'Woman\'],\n    targetInterests: [\'Volunteering/community service\']\n  },\n  {\n    id: \'w-grad-fellowship-science\',\n    name: \"Western Graduate Research Fellowship in Science\",\n    organization: \"School of Graduate and Postdoctoral Studies\",\n    amount: \"$12,000\",\n    deadline: \"May 15, 2027\",\n    eligibilitySummary: \"Awarded to master\'s or doctoral students in Science who demonstrate top-tier academic merit (85%+ GPA) and research publications or potential.\",\n    applicationUrl: \"https://grad.uwo.ca/finances/western_funding/index.html\",\n    targetDegree: \'Graduate\',\n    targetFaculties: [\'Science\'],\n    minGpaRange: \'85\342\200\22389%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'STEM research\']\n  },\n  {\n    id: \'w-international-student-award\',\n    name: \"Western International Student Excellence Award\",\n    organization: \"Western International\",\n    amount: \"$4,000\",\n    deadline: \"October 15, 2026\",\n    eligibilitySummary: \"Supports exceptional international students registered in any faculty at Western who demonstrate strong academic records (80%+ GPA) and global citizenship qualities.\",\n    applicationUrl: \"https://iesc.uwo.ca/financial_support/index.html\",\n    targetDegree: \'All\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'International student\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'out-of-province-leadership\',\n    name: \"Out-of-Province Student Leadership Award\",\n    organization: \"Western University\",\n    amount: \"$5,000\",\n    deadline: \"November 30, 2026\",\n    eligibilitySummary: \"Recognizes undergraduate students coming to Western from outside Ontario who have demonstrated excellent leadership in their high school or regional communities.\",\n    applicationUrl: \"https://registrar.uwo.ca/student_finances/scholarships_awards/index.html\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Other Canadian province\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\', \'Volunteering/community service\']\n  },\n  {\n    id: \'w-disabilities-access\',\n    name: \"Western Access Award for Students with Disabilities\",\n    organization: \"Student Experience - Accessible Education\",\n    amount: \"$3,500\",\n    deadline: \"December 15, 2026\",\n    eligibilitySummary: \"Awarded to undergraduate students registered with Accessible Education at Western who demonstrate financial need and academic capability.\",\n    applicationUrl: \"https://academicsupport.uwo.ca/accessible_education/\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [\'Student with disability\'],\n    targetInterests: []\n  },\n  {\n    id: \'lgbtq2s-community-leader\',\n    name: \"Western Pride & LGBTQ2S+ Community Leader Scholarship\",\n    organization: \"Western University Ally Network\",\n    amount: \"$2,500\",\n    deadline: \"April 30, 2027\",\n    eligibilitySummary: \"Offered to students of any faculty and year who are active in advocating for or leading LGBTQ2S+ equity, inclusivity, or support networks.\",\n    applicationUrl: \"https://www.uwo.ca/equity/gender_diversity/index.html\",\n    targetDegree: \'All\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [\'LGBTQ2S+\'],\n    targetInterests: [\'Volunteering/community service\', \'Leadership\']\n  },\n  {\n    id: \'first-gen-business-trailblazer\',\n    name: \"First-Gen Business Trailblazer Award\",\n    organization: \"Ivey & Western Business Alumni\",\n    amount: \"$6,000\",\n    deadline: \"January 15, 2027\",\n    eligibilitySummary: \"Supports first-generation university students entering Business/Ivey programs who show an entrepreneurial spirit and local volunteer involvement.\",\n    applicationUrl: \"https://www.ivey.uwo.ca/hba/program-details/first-generation/\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Business/Ivey\'],\n    minGpaRange: \'75\342\200\22379%\',\n    targetCitizenships: [\'All\'],\n    targetProvinces: [\'All\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [\'First-generation student\'],\n    targetInterests: [\'Entrepreneurship\', \'Volunteering/community service\']\n  },\n  {\