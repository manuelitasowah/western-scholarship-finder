icationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'Engineering\'],\n    minGpaRange: \'70\342\200\22374%\',\n    targetCitizenships: [\'International student\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: false,\n    targetIdentities: [],\n    targetInterests: [\'Leadership\']\n  },\n  {\n    id: \'dennis-logan-award\',\n    name: \"Dennis Logan Award\",\n    organization: \"Western University\",\n    amount: \"$600\",\n    deadline: \"September 30, 2026\",\n    eligibilitySummary: \"Undergraduate entrance scholarship based on academic performance (80%+ admission average) and financial need. Requires Ontario residency.\",\n    applicationUrl: \"https://studentservices.uwo.ca/secure/Awards/awardMain.cfm\",\n    targetDegree: \'Undergraduate\',\n    targetFaculties: [\'All\'],\n    minGpaRange: \'80\342\200\22384%\',\n    targetCitizenships: [\'Canadian citizen\', \'Permanent resident\'],\n    targetProvinces: [\'Ontario\'],\n    requiresFinancialNeed: true,\n    targetIdentities: [],\n    targetInterests: []\n  }\n];\n"
